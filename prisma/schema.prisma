generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ─────────────────────────────────────────────────
model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String      // bcrypt hashed
  firstName           String
  lastName            String
  mobile              String      @unique
  dateOfBirth         String      // stored as dd/MM/yyyy
  panNumber           String      @unique // encrypted before storing
  
  // ── Address ───────────────────────────────────────────
  addressLine1        String
  addressLine2        String?
  city                String
  state               String
  pincode             String

  // ── Account Security ──────────────────────────────────
  isActive            Boolean     @default(true)
  isMobileVerified    Boolean     @default(false)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?   // null = not locked
  lastLoginAt         DateTime?

  // ── KYC ───────────────────────────────────────────────
  kycStatus           KycStatus   @default(PENDING)

  // ── Timestamps ────────────────────────────────────────
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // ── Relations ─────────────────────────────────────────
  refreshTokens       RefreshToken[]
  proposals           Proposal[]

  @@map("users")
}

// ─── KYC STATUS ───────────────────────────────────────────
enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── REFRESH TOKEN ────────────────────────────────────────
model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── PROPOSAL ─────────────────────────────────────────────
model Proposal {
  id              String          @id @default(uuid())
  userId          String
  proposalNum     String          @unique
  proposerGuid    String          // CSRF for payment form — must equal proposer party's guid sent in createPolicy
  loanAccNum      String          @unique
  loanAmount      Float
  loanTenure      Int
  loanTenureUnit  String
  loanDisbursalDt String
  coverType       String
  sumInsured      String
  term            Int
  addOns          String?
  premium         Float?
  baseProductId   String
  status          ProposalStatus  @default(PAYMENT_PENDING)
  rawRequest      Json?           // full createPolicy payload for debugging / replay
  rawResponse     Json?           // Care's createPolicy response
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  paymentRecords  PaymentRecord[]
  policy          Policy?

  @@map("proposals")
}

// ─── PROPOSAL STATUS ──────────────────────────────────────
enum ProposalStatus {
  PAYMENT_PENDING
  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  INFORCE
  PENDING_UW
  DECLINED
}

// ─── PAYMENT RECORD ───────────────────────────────────────
model PaymentRecord {
  id            String        @id @default(uuid())
  proposalId    String
  proposalNum   String
  policyNum     String?
  txnRefNum     String?
  receiptNum    String?
  uwDecision    String?
  errorFlag     String?
  errorMessage  String?
  status        PaymentStatus
  rawResponse   Json?
  createdAt     DateTime      @default(now())

  proposal      Proposal      @relation(fields: [proposalId], references: [id])

  @@map("payment_records")
}

// ─── PAYMENT STATUS ───────────────────────────────────────
enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  UNKNOWN
}

// ─── CARE PARTNER SESSION ─────────────────────────────────
// Tracks a Care `generatePartnerToken` response: one session lives 15 min
// and yields 25 single-use tokens. Per Care doc v1.0 (page 5).
model CareSession {
  id          String      @id @default(uuid())
  sessionId   String      @unique // value Care returned in `partnerTokenGeneratorInputIO.sessionId`
  expiresAt   DateTime    // createdAt + 15 minutes
  createdAt   DateTime    @default(now())

  tokens      CareToken[]

  @@map("care_sessions")
}

// ─── CARE TOKEN ───────────────────────────────────────────
// One row per token in `listOfToken[]`. Single-use: `isUsed=true` after consumption.
model CareToken {
  id          String      @id @default(uuid())
  sessionId   String      // FK → CareSession.id
  tokenKey    String
  tokenValue  String
  isUsed      Boolean     @default(false)
  usedAt      DateTime?
  createdAt   DateTime    @default(now())

  session     CareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, isUsed])
  @@map("care_tokens")
}

// ─── CARE API AUDIT LOG ───────────────────────────────────
// One row per outbound Care API call — used for support, debugging,
// reconciliation, and meeting Care's "report errors to CHI" workflow
// (doc page 17).
model CareApiLog {
  id            String   @id @default(uuid())
  label         String   // e.g. "createPolicy", "generatePartnerToken"
  url           String
  request       Json?
  response      Json?
  errorMessage  String?
  httpStatus    Int?
  durationMs    Int?
  userId        String?  // null for partner-level calls like token gen
  proposalNum   String?  // best-effort tag for fast filtering
  createdAt     DateTime @default(now())

  @@index([label, createdAt])
  @@index([proposalNum])
  @@map("care_api_logs")
}

// ─── POLICY ───────────────────────────────────────────────
model Policy {
  id              String    @id @default(uuid())
  proposalId      String    @unique
  proposalNum     String    @unique
  policyNum       String    @unique
  policyStatus    String
  premium         Float
  commencementDt  String?
  maturityDt      String?
  pdfGenerated    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  proposal        Proposal  @relation(fields: [proposalId], references: [id])

  @@map("policies")
}